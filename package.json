{
  "name": "jones-vendor-onboarding",
  "version": "1.0.0",
  "description": "Jones Vendor Onboarding (VOB): online replacement for the FIN-010-IE01 vendor account set-up form, with approvals and automatic vendor creation in SAP ECC.",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "@cap-js/audit-logging": "1.3.0",
    "@cap-js/hana": "3.1.2",
    "@sap-cloud-sdk/connectivity": "4.10.0",
    "@sap-cloud-sdk/http-client": "4.10.0",
    "@sap/cds": "10.2.2",
    "@sap/xssec": "4.16.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@abaplint/cli": "2.120.100",
    "@axe-core/playwright": "4.14.0",
    "@cap-js/cds-test": "1.0.2",
    "@cap-js/sqlite": "3.1.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@sap/cds-dk": "10.2.1",
    "eslint": "9.39.5",
    "fflate": "0.8.3",
    "mbt": "1.2.51"
  },
  "scripts": {
    "start": "cds-serve",
    "demo": "cds serve all --with-mocks --in-memory",
    "watch": "cds watch",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=srv/** test/*.test.js",
    "build": "node scripts/build.cjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "lint": "eslint . --max-warnings=0",
    "lint:abap": "abaplint .abaplint.json",
    "package:abap": "node scripts/package-abap.cjs",
    "build:cap": "cds build --production && node scripts/stage-app.cjs"
  },
  "cds": {
    "requires": {
      "vob": {
        "sap": "mock",
        "mail": "local",
        "scanner": "mock",
        "demoData": false,
        "jobMinutes": 15
      },
      "[development]": {
        "auth": {
          "kind": "custom",
          "impl": "srv/auth/dev-auth.js"
        },
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "vob": {
          "demoData": true,
          "allowFraming": true,
          "retryDelays": [
            0,
            1500,
            3000
          ]
        }
      },
      "[test]": {
        "auth": {
          "kind": "custom",
          "impl": "srv/auth/dev-auth.js"
        },
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "vob": {
          "demoData": false,
          "jobMinutes": 0,
          "retryDelays": [
            0,
            10,
            20
          ]
        },
        "audit-log": {
          "kind": "audit-log-to-console"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana",
        "vob": {
          "sap": "http",
          "mail": "graph",
          "scanner": "btp"
        },
        "vob-ecc": {
          "kind": "rest",
          "credentials": {
            "destination": "VOB_ECC",
            "path": "/sap/zvob/v1"
          }
        },
        "vob-graph": {
          "kind": "rest",
          "credentials": {
            "destination": "VOB_GRAPH"
          }
        }
      }
    },
    "server": {
      "index": false
    },
    "sql": {
      "native_hana_associations": false
    }
  },
  "allowScripts": {
    "mbt@1.2.51": true
  }
}
